package scutil.lang.tc

object ApplicativeTupleNSyntax {
	extension [F[_],S1](items:Tuple1[F[S1]]) {
		def zipN(using F:Applicative[F]):F[Tuple1[S1]]	=
			mapN(Tuple1.apply)

		def mapN[T](func:(S1)=>T)(using F:Applicative[F]):F[T]	=
			F.map(items._1)(func)
	}

	[2..#extension [F[_],[#S1#]](items:([#F[S1]#])) {
		def zipN(using F:Applicative[F]):F[([#S1#])]	=
			mapN(Tuple1.apply)

		def mapN[T](func:([#S1#])=>T)(using F:Applicative[F]):F[T]	= {
			[1..1#val f0	= func.curried
			val f1	= F.map(items._1)(f0)#]
			[2..#val f1	= F.ap(f0)(items._1)#
			]
			f1
		}
	}#

	]
}
